root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,neon,neon.dist}]
indent_size = 4

[.github/**.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4
